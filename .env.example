# Copy to .env.local for local work. On Vercel add these under Settings, Environment Variables.

# Public site address, no trailing slash. Used for canonical links, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://kumbhalkar-college.vercel.app

# Contact details. Leave blank until confirmed; the page then shows its bracketed placeholders.
NEXT_PUBLIC_WHATSAPP=          # country code + number, digits only, e.g. 919876543210
NEXT_PUBLIC_PHONE=             # e.g. +91 98765 43210
NEXT_PUBLIC_EMAIL=             # e.g. admissions@yourdomain.in

# Where each lead is forwarded (Google Apps Script web app, Zapier, Make, Slack...). Server side only.
# If blank, leads are written to the Vercel function logs.
LEAD_WEBHOOK_URL=
